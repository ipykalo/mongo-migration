{
  "$jsonSchema": {
    "bsonType": "object",
    "required": ["username", "status"],
    "properties": {
      "username": { "bsonType": "string" },
      "status": {
        "enum": ["active", "suspended", "pending"],
        "description": "can only be one of the enum values"
      },
      "dob": {
        "bsonType": "object",
        "properties": {
          "age": { "bsonType": "int" },
          "year": { "bsonType": "int" }
        }
      }
    }
  }
}
